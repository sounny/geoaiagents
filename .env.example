# Comma-separated list of plugin modules to load
GEOAI_PLUGIN_MODULES=

# Enable debug output (1, true, True)
HUMBOLDT_DEBUG=

# Maximum steps for agent loops
HUMBOLDT_MAX_STEPS=

# Model used by Humboldt
HUMBOLDT_MODEL=

# OpenAI API Key
OPENAI_API_KEY=

# Base URL for OpenAI API compatible endpoints
OPENAI_BASE_URL=

# Model used by OpenAI clients
OPENAI_MODEL=
